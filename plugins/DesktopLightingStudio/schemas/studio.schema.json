{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openrgb.org/plugins/DesktopLightingStudio/schemas/studio.schema.json",
  "title": "Desktop Lighting Studio workspace",
  "description": "Authoritative active workspace document (studio.json). Scene objects, bindings, colors, input/output settings, and editor preferences. Units: meters for positions/sizes, degrees for rotation, packed colors written as \"#RRGGBB\".",
  "type": "object",
  "required": ["schema_version", "scene"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Workspace schema version. Documents newer than the supported version are rejected, not rewritten."
    },
    "name": { "type": "string" },
    "ui": {
      "type": "object",
      "properties": {
        "theme": { "type": "string", "default": "graphite" },
        "reduced_motion": { "type": "boolean", "default": false }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "view": { "type": "string", "enum": ["desk", "top", "front", "case", "free"], "default": "desk" },
        "projection": { "type": "string", "enum": ["orthographic", "perspective"], "default": "orthographic" }
      }
    },
    "controls": {
      "type": "object",
      "properties": {
        "middle_drag": { "type": "string", "enum": ["pan", "orbit"], "default": "pan" },
        "move_snap_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.01 },
        "rotate_snap_deg": { "type": "number", "exclusiveMinimum": 0, "default": 15 }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "quality": { "type": "string", "enum": ["low", "balanced", "high"], "default": "balanced" },
        "bloom": { "type": "boolean", "default": true }
      }
    },
    "inputs": {
      "type": "object",
      "properties": {
        "audio": { "type": "boolean", "default": false },
        "keys": { "type": "boolean", "default": false },
        "screen": { "type": "boolean", "default": false },
        "screen_index": { "type": "integer", "minimum": 0, "default": 0 },
        "sens_pct": { "type": "integer", "minimum": 25, "maximum": 200, "default": 100 },
        "decay_pct": { "type": "integer", "minimum": 50, "maximum": 300, "default": 100 }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "brightness": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "live_on_startup": {
          "type": "boolean",
          "default": false,
          "description": "Restore live hardware output on startup. Defaults false; migration and imported documents may never enable it."
        }
      }
    },
    "scene": {
      "type": "object",
      "description": "SceneJson v2 document. name/brightness/effect live in the top-level sections instead.",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 2 },
        "bindings": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "controller_name": { "type": "string" },
              "vendor": { "type": "string" },
              "serial": { "type": "string" },
              "location": { "type": "string" },
              "device_type": { "type": "integer" },
              "zone_name": { "type": "string" },
              "zone_leds": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "objects": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["decor", "device", "linked", "group"] },
              "parent_id": { "type": "string", "description": "Placement frame owner; must resolve, no cycles." },
              "position": { "$ref": "#/definitions/vec3" },
              "rotation": { "$ref": "#/definitions/vec3", "description": "Euler XYZ degrees, Rz*Ry*Rx order." },
              "scale": { "$ref": "#/definitions/vec3", "description": "Dimensionless; every component must be > 0." },
              "size_m": { "$ref": "#/definitions/vec3", "description": "Body dimensions in meters (pre-scale); each component >= 0, and a 0 component falls back to the geometry's canonical axis size ({0,0,0} = full canonical size)." },
              "binding": { "type": "string", "description": "DeviceBinding id; must resolve when set." },
              "mirror_of": { "type": "string", "description": "Linked objects only; must name a non-linked object." },
              "geometry": { "type": "string" },
              "layout": { "type": "string" },
              "verified": { "type": "boolean" },
              "visible": { "type": "boolean" },
              "emitters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pos": { "$ref": "#/definitions/vec3" },
                    "group": { "type": "string" },
                    "address": {
                      "type": "integer",
                      "minimum": -1,
                      "description": "LED index in the bound zone, or -1 for render-only. Must be < the binding's zone_leds when that is nonzero."
                    }
                  }
                }
              }
            }
          }
        },
        "object_colors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/color" }
        },
        "emitter_colors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/color" }
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "preset": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "uint32 remix seed — remix() spans the full unsigned range." },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "playing": { "type": "boolean" },
        "layers": {
          "type": "array",
          "description": "Reserved for JSON effect layer definitions; retained verbatim on save/load."
        }
      }
    },
    "definitions": {
      "type": "object",
      "properties": {
        "devices": { "type": "array" },
        "effects": { "type": "array" }
      },
      "description": "Device/effect preset snapshots used by this workspace; authoritative for it."
    },
    "extensions": {
      "type": "object",
      "description": "Third-party extension data, retained verbatim."
    }
  },
  "definitions": {
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "color": {
      "oneOf": [
        { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        { "type": "integer", "minimum": 0, "maximum": 16777215 }
      ],
      "description": "\"#RRGGBB\" preferred; packed 0x00BBGGRR integer accepted for older files."
    }
  }
}
