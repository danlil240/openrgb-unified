      "direction": { "remix_yaw": [1.0, 0.0, 0.0, -0.3, 0.3] },
      "scale": 0.25,
      "speed": { "remix": [0.2, 0.4] },
      "density": 1.4,
      "palette": [
        { "pos": 0.0, "color": "#00E0C0" },
        { "pos": 0.6, "color": "#003030" }
